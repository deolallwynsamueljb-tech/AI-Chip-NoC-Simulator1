# Port the backend (Express + WebSocket) listens on.
PORT=8787

# Groq API key, used server-side only by the AI assistant feature
# (POST /api/assistant/ask). Never exposed to the browser. Get one at
# https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the Groq model used by the assistant.
GROQ_MODEL=openai/gpt-oss-120b
